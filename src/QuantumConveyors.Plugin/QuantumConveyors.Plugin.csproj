<Project Sdk="Microsoft.NET.Sdk">
  <!-- One file: QuantumConveyors.dll, with the model, textures and build-menu pictures (Assets/) embedded. -->
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>QuantumConveyors</AssemblyName>
    <RootNamespace>QuantumConveyors</RootNamespace>
    <Version>2.0.0</Version>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- The game folder (with BepInEx installed and run once, so BepInEx/interop exists). Override with
       -p:MoonSweepersGameRoot=... ; the defaults are Steam's usual folders on Windows and Linux. -->
  <PropertyGroup Condition="'$(MoonSweepersGameRoot)' == ''">
    <MoonSweepersGameRoot Condition="'$(OS)' == 'Windows_NT'">C:\Program Files (x86)\Steam\steamapps\common\Moon Sweepers</MoonSweepersGameRoot>
    <MoonSweepersGameRoot Condition="'$(OS)' != 'Windows_NT'">$(HOME)/.local/share/Steam/steamapps/common/Moon Sweepers</MoonSweepersGameRoot>
  </PropertyGroup>
  <PropertyGroup>
    <BepInExCore>$(MoonSweepersGameRoot)/BepInEx/core</BepInExCore>
    <InteropDir>$(MoonSweepersGameRoot)/BepInEx/interop</InteropDir>
    <PluginDir>$(MoonSweepersGameRoot)/BepInEx/plugins</PluginDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BepInEx.Core" HintPath="$(BepInExCore)/BepInEx.Core.dll" Private="false" />
    <Reference Include="BepInEx.Unity.IL2CPP" HintPath="$(BepInExCore)/BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(BepInExCore)/0Harmony.dll" Private="false" />
    <Reference Include="Il2CppInterop.Runtime" HintPath="$(BepInExCore)/Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="Il2CppInterop.Common" HintPath="$(BepInExCore)/Il2CppInterop.Common.dll" Private="false" />
    <Reference Include="Il2Cppmscorlib" HintPath="$(InteropDir)/Il2Cppmscorlib.dll" Private="false" />
    <Reference Include="Assembly-CSharp" HintPath="$(InteropDir)/Assembly-CSharp.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(InteropDir)/UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.PhysicsModule" HintPath="$(InteropDir)/UnityEngine.PhysicsModule.dll" Private="false" />
    <Reference Include="UnityEngine.UIModule" HintPath="$(InteropDir)/UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(InteropDir)/UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(InteropDir)/UnityEngine.UI.dll" Private="false" />
    <Reference Include="Unity.InputSystem" HintPath="$(InteropDir)/Unity.InputSystem.dll" Private="false" />
    <Reference Include="MoonFramework" HintPath="$(PluginDir)/MoonFramework.dll" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets/*" LogicalName="Assets/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
